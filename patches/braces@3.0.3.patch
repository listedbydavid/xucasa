diff --git a/lib/check-depth.js b/lib/check-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..fbf690647b41a91bd84f9227e5f6525fb60281a9
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,30 @@
+'use strict';
+
+// Recursive walkers must never receive an unbounded AST, including ASTs
+// supplied directly to compile(), expand(), and stringify().
+const MAX_DEPTH = 100;
+const MAX_NODES = 65536;
+
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  let count = 0;
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > MAX_DEPTH || ++count > MAX_NODES || seen.has(node)) {
+      throw new SyntaxError('Brace pattern exceeds safe AST complexity');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      if (node.nodes.length + pending.length > MAX_NODES) {
+        throw new SyntaxError('Brace pattern exceeds safe AST complexity');
+      }
+      for (const child of node.nodes) {
+        pending.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
+
+module.exports.MAX_DEPTH = MAX_DEPTH;
